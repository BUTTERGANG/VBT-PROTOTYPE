# VBT Tracker Backend Environment Variables
# Copy this file to .env and fill in your values

# Required: Neon PostgreSQL connection string
# Create a free database at https://console.neon.tech
# The sslmode=require suffix is automatically added if missing
DATABASE_URL=postgresql://user:password@ep-xxx.region.neon.tech/neondb

# Optional: Python FastAPI autoregulation service URL
# Set this if running the autoregulate service alongside the backend
FASTAPI_URL=http://localhost:8000

# Server port (Replit sets this automatically)
PORT=3001

# Set to 'production' when deploying (enables PWA static file serving)
NODE_ENV=development

# Required: JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be kept secret and consistent across deployments (changing it invalidates all sessions)
JWT_SECRET=replace-with-a-long-random-secret
