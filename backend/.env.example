# Copy to .env and fill in values

# Neon connection string — get this from your Neon dashboard
# Format: postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.neon.tech/vbt_tracker?sslmode=require

# Server port (Replit sets PORT automatically)
PORT=3001
