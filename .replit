# Replit configuration
# Docs: https://docs.replit.com/programming-ide/configuring-repl

language = "nodejs"

# Development: start autoregulate service, build PWA, run backend (serves PWA at /*)
run = ["bash", "start.sh"]

[nix]
channel = "stable-25_05"

[deployment]
# Production: build PWA + backend, then start compiled backend
build = ["sh", "-c", "cd pwa && npm install && npm run build && cd ../backend && npm install && npm run build"]
run = ["sh", "-c", "cd backend && NODE_ENV=production npm run start"]

[[ports]]
localPort = 3001
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[agent]
expertMode = true
